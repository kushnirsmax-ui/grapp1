# --- Для Docker-розгортання (docker-compose.prod.yml) ---
# Домен без https:// (DNS-запис A має вказувати на ваш сервер)
DOMAIN=
# Пароль бази: лише латиниця й цифри, напр. openssl rand -hex 16
DB_PASSWORD=

# --- Обов'язкове ---
DATABASE_URL=postgres://grappshopp:CHANGE_ME@localhost:5432/grappshopp
# Довгий випадковий рядок (мін. 32 символи): openssl rand -hex 32
JWT_SECRET=
# --- Сервер ---
PORT=3000
# Кількість з'єднань з базою (на спільному хостингу ставте 3)
DB_POOL_MAX=10
NODE_ENV=development
BASE_URL=http://localhost:3000
# 1, якщо перед сервером стоїть nginx/Cloudflare (для коректних IP і rate limit)
TRUST_PROXY=0
UPLOAD_DIR=./uploads
# --- Пошта (відновлення пароля, розсилки, сповіщення про замовлення) ---
# Спосіб 1 (для Railway та хостингів, де SMTP заблоковано): HTTPS-API. Достатньо одного з двох ключів:
RESEND_API_KEY=
BREVO_API_KEY=
# Спосіб 2: SMTP
# приклад: smtps://user:password@smtp.example.com:465
SMTP_URL=
MAIL_FROM=GRAPPSHOPP <no-reply@your-domain.ua>
ADMIN_EMAIL=
# 1 = не відправляти, а виводити листи в консоль (для розробки)
MAIL_DRY_RUN=0
# пауза між листами розсилки, мс
MAIL_DELAY_MS=300

# --- Автозапуск бази (для Railway) ---
# 1 = створити схему й початкові дані, якщо база порожня, і застосовувати нові міграції
AUTO_DB_INIT=0
# Перший адміністратор (створюється, лише якщо адмінів ще немає). Після першого входу видаліть пароль зі змінних.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
