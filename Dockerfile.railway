# Образ для Railway. Працює від root, бо том (volume) Railway монтується з правами root.
FROM node:22-alpine
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev
COPY app.js ./
COPY src ./src
COPY public ./public
COPY db ./db
COPY scripts ./scripts
ENV NODE_ENV=production \
    UPLOAD_DIR=/data/uploads \
    AUTO_DB_INIT=1 \
    TRUST_PROXY=1 \
    DB_POOL_MAX=5
CMD ["node", "src/server.mjs"]
