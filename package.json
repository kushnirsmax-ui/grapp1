{
  "name": "grappshopp",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node --watch src/server.mjs",
    "db:init": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/schema.sql && psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/seed.sql",
    "db:init:shared": "node scripts/db-init.mjs db/schema_shared.sql db/seed_prod.sql",
    "set-password": "node scripts/set-password.mjs",
    "create-admin": "node scripts/create-admin.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.14",
    "pg": "^8.12.0",
    "sanitize-html": "^2.18.2"
  },
  "main": "app.js"
}